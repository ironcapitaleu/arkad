# Copy this file to `supabase/.env`. The Supabase CLI reads it when the stack starts.

# The frontend URL. The sign-in mail links to `<site URL>/auth/confirm`.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000
# The URLs that Supabase Auth redirects to after a sign-in. `**` matches every path.
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:3000/**

# Resend is off locally, so Mailpit catches every mail.
SUPABASE_AUTH_EMAIL_SMTP_ENABLED=false
SUPABASE_AUTH_EMAIL_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_EMAIL_SMTP_USER=resend
SUPABASE_AUTH_EMAIL_SMTP_PASS=
SUPABASE_AUTH_EMAIL_SMTP_ADMIN_EMAIL=you@example.com
SUPABASE_AUTH_EMAIL_SMTP_SENDER_NAME=Arkad

# The OAuth apps of Google and GitHub. Both providers stay off until the apps exist.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
